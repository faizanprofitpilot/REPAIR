# REPAIR environment variables
# Copy to .env and fill in. NEVER commit .env.

# --- LLM (required from M2) ---
OPENAI_API_KEY=
# Optional override; defaults used if unset:
# REPAIR_SUPPORT_MODEL=gpt-4.1-mini
# REPAIR_FLOW_MODEL=gpt-4.1

# --- One (required from M0/M1) ---
ONE_SECRET=
ONE_STRIPE_CONNECTION_KEY=
ONE_LINEAR_CONNECTION_KEY=
# ONE_API_BASE=https://api.withone.ai

# --- You.com (required from M3) ---
YDC_API_KEY=

# --- Daytona (required from M4) ---
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# --- Demo / Linear ---
# LINEAR_TEAM_KEY=   # optional; first team used if unset
REPAIR_FAULT_MODE=CommitThenDisconnect
REPAIR_ENGINE_PORT=8000
REPAIR_WEB_ORIGIN=http://localhost:3000
